{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.deps/ortools",
        "FETCHCONTENT_SOURCE_DIR_NLOHMANN_JSON": "${sourceDir}/.deps/json",
        "FETCHCONTENT_SOURCE_DIR_JSON_SCHEMA": "${sourceDir}/.deps/json-schema-validator"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
