{
  "name": "rostercore",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs --production",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "test:server": "node --test tests/server.test.mjs tests/workspace.test.mjs",
    "test:exports": "node --test tests/export-files.test.mjs",
    "desktop": "electron .",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "package:desktop": "cmake --install ../build --config Release --prefix ../build/desktop-runtime && electron-builder --x64 --publish never"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "description": "Workforce scheduling and calendar management",
  "author": "RosterCore contributors <ossacolsale@users.noreply.github.com>",
  "homepage": "https://github.com/ossacolsale/rostercore",
  "license": "Apache-2.0",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.16.0"
  }
}
