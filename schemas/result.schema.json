{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rostercore.org/schemas/v1/result.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "enum": [
        "rostercore.result"
      ]
    },
    "schemaVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "status": {
      "enum": [
        "VALIDATION_ERROR",
        "MODEL_INVALID",
        "INFEASIBLE",
        "FEASIBLE",
        "OPTIMAL",
        "UNKNOWN",
        "VALID",
        "VERIFIED",
        "IMPORTED",
        "PREVIEW",
        "CONSOLIDATED",
        "CONTEXT",
        "MIGRATED",
        "INSPECTED"
